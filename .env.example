# DeepSeek (analysis / chat)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-v4-flash

# PostgreSQL (Prisma) — local instance
# Adjust user, password, host, port and database name to match your install.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pdfanalyze?schema=public"

# Secret used to sign the session JWT. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Monthly token quota granted to each new user on sign-up.
TOKEN_MONTHLY_QUOTA=100000
